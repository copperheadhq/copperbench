---
import Base from '../layouts/Base.astro';
import { to } from '../lib/links';

const at = Astro.url.pathname;
---

<Base title="Not found" description="There is no page at this address." noindex>
  <div class="main" style="margin-left: 0;">
    <div class="container" style="padding-top: 4rem;">
      <section class="section">
        <h2 class="section-title">Not found</h2>
        <p class="section-lead">
          There is no page at this address. The leaderboard is at <a href={to(at, '')}>the front page</a>; the standard, tasks, fixtures and
          result records are in the sidebar there.
        </p>
      </section>
    </div>
  </div>
</Base>
