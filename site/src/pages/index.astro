---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Hero from '../components/Hero.astro';
import Leaderboard from '../components/Leaderboard.astro';
import Discrimination from '../components/Discrimination.astro';
import Incomparable from '../components/Incomparable.astro';
import Status from '../components/Status.astro';
import Fixtures from '../components/Fixtures.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="copperbench"
  description="A benchmark for language-model agents that edit KiCad hardware designs. Tasks run on real boards, results are checked with kicad-cli, and pass rates are published alongside cost."
>
  <Sidebar />
  <div class="main">
    <Hero />
    <div class="container">
      <Leaderboard />
      <Discrimination />
      <Incomparable />
      <Status />
      <Fixtures />
    </div>
    <Footer />
  </div>
</Base>
