---
// The main content: the two headline numbers per tier and per model, with the
// comparability, unscoreable and cost-segmentation rules stated where the
// reader meets the numbers. Rows come from leaderboard.ts; nothing is computed
// here beyond formatting.
import { TIERS, type Row, type Segment, type Tier } from '../../../scripts/lib/leaderboard.ts';
import Icon from './Icon.astro';
import { capitalize, facts, plural } from '../lib/facts';
import { to } from '../lib/links';

const at = Astro.url.pathname;
const lb = facts.leaderboard;
const tierCount = (t: Tier) => facts.tasks.filter((x) => x.tier === t).length;
const variants = facts.tasks.filter((t) => t.variantOf !== null).length;

const TIER_BLURB: Record<Tier, string> = {
  simple: 'Single-sheet boards. One edit, with one other place it has to be carried through to.',
  medium: 'Edits that have to respect a stated constraint, and requests that should be refused with a reason that points at the file.',
  hard: 'Multi-sheet hierarchical designs, where a change on one sheet has to be followed through on the others.',
};

const pct = (x: number | null) => (x === null ? 'n/a' : (x * 100).toFixed(1));
const usd = (x: number | null) => (x === null ? 'n/a' : `$${x.toFixed(2)}`);

const COSTED = new Set<Segment>(['api-frontier', 'api-cheap', 'open-weight-hosted']);
const isCosted = (s: Segment | null) => s !== null && COSTED.has(s);
const isOpenWeight = (s: Segment | null) => s === 'open-weight-hosted' || s === 'open-weight-self-hosted';

const SEGMENT_LABEL: Record<Segment, string> = {
  'api-frontier': 'Direct API, frontier',
  'api-cheap': 'Direct API, cheap',
  'open-weight-hosted': 'Open-weight, hosted',
  'open-weight-self-hosted': 'Open-weight, self-hosted',
  'saved-login': 'Saved login',
};
const segmentLabel = (s: Segment | null) => (s === null ? 'not recorded' : SEGMENT_LABEL[s]);
const barWidth = (r: Row) => (r.strictPassRate === null ? 0 : r.strictPassRate * 100).toFixed(1);
---

<section class="section" id="leaderboard">
  <div class="tabs" role="tablist" aria-label="Tier">
    {TIERS.map((t, i) => (
      <button class="tab" role="tab" id={`tab-${t}`} aria-controls={`panel-${t}`} aria-selected={i === 0 ? 'true' : 'false'}>
        {capitalize(t)}<span class="count num">{lb.tiers[t].length}</span>
      </button>
    ))}
  </div>

  {TIERS.map((t, i) => (
    <div class="panel" id={`panel-${t}`} role="tabpanel" aria-labelledby={`tab-${t}`} hidden={i !== 0}>
      <div class="leaderboard-head">
        <p>
          Strict pass rate and cost per passing task for each model on the <b>{t}</b> tier ({plural(tierCount(t), 'task')}).
          The table is built from <a href={to(at, 'results')}>the result records</a> on every deploy. A record is included when its suite version, task manifest hash,
          fixture hash and <code>kicad-cli</code> major version match the checked-out suite. Records that don't match are listed
          further down under "Not comparable" and are left out of these figures.
        </p>
        <div class="filters">
          <label><input type="checkbox" data-filter="costed"><span>Costed routes only</span></label>
          <span class="hint">Direct API and hosted open-weight routes have a known per-token price. Self-hosted and saved-login routes don't, so their cost is recorded as null and this filter hides them.</span>
        </div>
      </div>
      <div class="table-card">
        <table class="table">
          <thead>
            <tr>
              <th class="rank">#</th>
              <th>Model</th>
              <th>Route</th>
              <th class="right">Strict pass %</th>
              <th class="right">$ / pass</th>
              <th class="right" title="passes / scoreable runs; +n unscoreable">Passes</th>
              <th class="right">Repeats</th>
              <th class="center">Records</th>
              <th>copperhead</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            {lb.tiers[t].length === 0 ? (
              <tr>
                <td class="empty" colspan="10">
                  No model has been run on the {t} tier yet.{' '}
                  {lb.snapshot.harnessRecords > 0
                    ? <>The {plural(lb.snapshot.harnessRecords, 'harness record')} <a href="#discrimination">below</a> show that the tasks tell a no-op apart from a correct edit.</>
                    : 'The first results will appear once agent mode is implemented.'}
                </td>
              </tr>
            ) : (
              lb.tiers[t].map((r, rank) => (
                <tr data-segment={r.segment ?? ''} data-costed={isCosted(r.segment) ? 'true' : 'false'}>
                  <td class="rank num">{rank + 1}</td>
                  <td>
                    <div class="model-cell">
                      <span class="model">{r.model}</span>
                      {isOpenWeight(r.segment) && <span class="tag tag-open" title="Open-weights model"><Icon name="unlock" /></span>}
                    </div>
                  </td>
                  <td class="secondary">
                    <span class="model-cell">
                      {isCosted(r.segment)
                        ? <span class="tag tag-api" title="Costed route: exact price-table cost"><Icon name="check" /></span>
                        : <span class="tag tag-null" title="Uncosted route: cost is null"><Icon name="dash" /></span>}
                      <span>{segmentLabel(r.segment)}</span>
                    </span>
                  </td>
                  <td class="right">
                    <span class="meter">
                      <span class="value num">{pct(r.strictPassRate)}</span>
                      <span class="track"><span class="fill" style={`width: ${barWidth(r)}%`}></span></span>
                    </span>
                  </td>
                  <td class="right secondary num">{usd(r.costPerPass)}</td>
                  <td class="right secondary num">{r.passes}/{r.passes + r.fails}{r.unscoreable > 0 && <span class="muted"> +{r.unscoreable}</span>}</td>
                  <td class="right secondary num">{r.repeats}</td>
                  <td class="center"><a class="records" href={to(at, 'results')} title={plural(r.records, 'record')}><Icon name="arrow" /></a></td>
                  <td class="mono muted">{r.copperheadVersions.join(', ')}</td>
                  <td class="num muted">{r.latestDate}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  ))}

  <div class="notes">
    <p>
      Two numbers are reported per model. <b>Strict pass rate</b> is the fraction of scoreable runs in which every required assertion passed.
      <b>Cost per passing task</b> is the model's total spend in USD divided by its number of passes. A run is unscoreable when a required
      assertion couldn't be evaluated at all (ERC with no <code>kicad-cli</code> installed, for example); those runs are excluded from the rate
      and shown after the plus sign in the Passes column.
    </p>
    <ul class="legend">
      <li><span class="tag tag-open"><Icon name="unlock" /></span>Open-weights model</li>
      <li><span class="tag tag-api"><Icon name="check" /></span>Costed route: price known from the pricing table, exact model version pinned</li>
      <li><span class="tag tag-null"><Icon name="dash" /></span>Uncosted route: no price available, cost recorded as null</li>
    </ul>
    <div class="cards">
      {TIERS.map((t) => (
        <div class="card">
          <div class="card-header"><h4>{capitalize(t)}</h4><span class="card-count num">{plural(tierCount(t), 'task')}</span></div>
          <p>{TIER_BLURB[t]}</p>
          <a href={to(at, 'standard#2-the-unit-of-evaluation')}>Tier definition <Icon name="arrow" /></a>
        </div>
      ))}
      <div class="card">
        <div class="card-header"><h4>Variants</h4><span class="card-count num">{plural(variants, 'task')}</span></div>
        <p>The same task on a deterministically altered copy of its fixture. A model that does much better on the original than on the variant has probably seen the original before.</p>
        <a href={to(at, 'standard#111-memorization-variants')}>Memorization variants <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
  <a class="wide-button" href={to(at, 'standard#14-reproducing-a-published-number')}>How to re-score the published records yourself, with no API key</a>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      for (const t of tabs) t.setAttribute('aria-selected', String(t === tab));
      for (const p of panels) p.hidden = p.id !== tab.getAttribute('aria-controls');
    });
  }
  // Which routes are costed is decided once, in the frontmatter, and carried on each row.
  for (const box of document.querySelectorAll<HTMLInputElement>('[data-filter="costed"]')) {
    box.addEventListener('change', () => {
      const rows = box.closest('.panel')?.querySelectorAll<HTMLTableRowElement>('tbody tr[data-costed]') ?? [];
      for (const row of rows) row.hidden = box.checked && row.dataset.costed !== 'true';
    });
  }
</script>
