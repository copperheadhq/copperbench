---
// The fixture table: on the front page as a section, on the fixtures page
// under its own heading.
import Icon from './Icon.astro';
import { facts } from '../lib/facts';
import { to } from '../lib/links';

interface Props {
  /** Omit the section heading and lead, for embedding under another heading. */
  bare?: boolean;
}
const { bare = false } = Astro.props;
const at = Astro.url.pathname;
---

<section class="section" id="fixtures">
  {!bare && (
    <>
      <h2 class="section-title">Fixtures</h2>
      <p class="section-lead">
        The boards the tasks run on. Each is copied unchanged from a permissively licensed open-hardware project at a specific upstream
        commit, keeps its original LICENSE file, and is credited in NOTICE. Its content hash is recorded so a run can be checked against the
        exact files it saw. Only the design files go into the sandbox; the provenance notes and the baseline ERC and DRC reports are kept
        outside it, where the model can't read them.
      </p>
    </>
  )}
  <div class="table-card">
    <table class="table">
      <thead>
        <tr><th>Fixture</th><th>Upstream</th><th>Tier</th><th class="right">Sheets</th><th class="right">Symbols</th><th class="right">Schematic lines</th><th>License</th></tr>
      </thead>
      <tbody>
        {facts.fixtures.map((f) => (
          <tr>
            <td><a class="model" href={to(at, `fixtures/${f.id}`)}>{f.id}</a></td>
            <td class="secondary"><a href={f.url}>{f.name} <Icon name="ext" /></a></td>
            <td class="secondary">{f.complexity}</td>
            <td class="right secondary num">{f.sheets}</td>
            <td class="right secondary num">{f.symbols}</td>
            <td class="right secondary num">{f.schematicLines.toLocaleString('en-US')}</td>
            <td class="mono muted">{f.license}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
