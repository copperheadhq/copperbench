---
// Records whose stamps disagree with the checked-out suite. Listed, with the
// reason and never averaged in. Renders nothing when there are none.
import { facts, recordRoute } from '../lib/facts';
import { to } from '../lib/links';

const at = Astro.url.pathname;
const rows = facts.leaderboard.incomparable;
---

{rows.length > 0 && (
  <section class="section" id="incomparable">
    <h2 class="section-title">Not comparable</h2>
    <p class="section-lead">
      These records were produced under a different suite version, task manifest, fixture hash or <code>kicad-cli</code> major version,
      so they can't be compared with the rows above. They are kept for reference and don't contribute to any figure on this page.
    </p>
    <div class="table-card">
      <table class="table">
        <thead><tr><th>Record</th><th>Model</th><th>Task</th><th>Reason</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="mono"><a href={to(at, recordRoute(r.relPath))}>{r.relPath}</a></td>
              <td class="secondary">{r.model}</td>
              <td class="secondary"><a href={to(at, `tasks/${r.task}`)}>{r.task}</a></td>
              <td class="secondary">{r.reasons.join('; ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}
