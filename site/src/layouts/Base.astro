---
import { currentRoute, to } from '../lib/links';

interface Props {
  title: string;
  description: string;
  /** For pages that are not a canonical address, such as the not-found page. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

// Astro.site is always set (astro.config.mjs) and ends in a slash, so paths
// resolve under it rather than at its origin. The build writes .html files
// (build.format 'file') while the asset router serves them without the
// extension, so the canonical drops it; index collapses to the directory.
const site = Astro.site as URL;
const route = currentRoute(Astro.url.pathname);
const absolute = (p: string): string => new URL(p, site).href;
const canonical = noindex ? undefined : absolute(route);

// Asset URLs are relative to the page, so a nested page climbs back to the
// root the same way its links do. The not-found page is the exception: the
// asset router serves it in place at whatever address missed (wrangler.jsonc,
// not_found_handling), so it cannot know its depth and links absolutely.
const floating = route === '404';
const asset = (p: string): string => (floating ? absolute(p) : to(Astro.url.pathname, p));

// One image, rendered by site/og.mjs at the size the tags state.
const image = absolute('og.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="copperbench" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={description} />

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <meta name="theme-color" content="#b87333" />
    <link rel="stylesheet" href={asset('fonts/inter/index.css')} />
    <link rel="stylesheet" href={asset('fonts/ibm-plex-mono/400.css')} />
    <link rel="stylesheet" href={asset('fonts/ibm-plex-mono/500.css')} />
    <link rel="stylesheet" href={asset('styles.css')} />

    <!-- Google tag (gtag.js). is:inline keeps Astro from bundling these into a
         hoisted module, which would scope `gtag` away from the global the
         loader expects and drop the async loader tag from the output. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DN1FW6G2MM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DN1FW6G2MM');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
