---
interface Props {
  title: string;
  description: string;
  /** For pages that are not a canonical address, such as the not-found page. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

// Astro.site is always set (astro.config.mjs) and ends in a slash, so paths
// resolve under it rather than at its origin. The build writes .html files
// (build.format 'file') while the asset router serves them without the
// extension, so the canonical drops it; index collapses to the directory.
const site = Astro.site as URL;
const absolute = (p: string): string => new URL(p.replace(/^\//, ''), site).href;
const pathname = Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, '');
const canonical = noindex ? undefined : absolute(pathname);

// One image, rendered by site/og.mjs at the size the tags state.
const image = absolute('og.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="copperbench" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={description} />

    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="manifest" href="site.webmanifest" />
    <meta name="theme-color" content="#b87333" />
    <link rel="stylesheet" href="fonts/inter/index.css" />
    <link rel="stylesheet" href="fonts/ibm-plex-mono/400.css" />
    <link rel="stylesheet" href="fonts/ibm-plex-mono/500.css" />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <slot />
  </body>
</html>
