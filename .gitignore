node_modules/
dist/
.env

# Astro's build cache for the website (site/); site/dist/ is covered by dist/ above.
.astro/
# Typefaces copied from node_modules by site/copy-fonts.mjs before each build.
site/public/fonts/
# wrangler's local state for the Cloudflare deploy.
.wrangler/

# Sandboxes are materialized outside this repository and are never committed.
# Preserved evidence belongs under results/ as records, not as raw trees.
.sandboxes/
tmp/

# LaTeX build artifacts. paper/generated/ IS committed: it is the evidence
# binding, and a reader must see what the prose was compiled against.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.toc

# Page images rendered from main.pdf on every paper build. Derived output, like
# the PDF itself.
paper/render/
